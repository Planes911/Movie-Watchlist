# Local SQLite (zero setup):
# DATABASE_URL=sqlite:///./filmlog.db
# Supabase: Project > Connect > pooler connection string (URI format).
# Use the Transaction pooler (port 6543) when deploying to a serverless platform.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<host>.pooler.supabase.com:6543/postgres

# Secret used to sign JWTs, at least 16 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# API key from https://aistudio.google.com
GEMINI_API_KEY=
# Model names change often; pick one from the list available to your key.
GEMINI_MODEL=

# Allowed frontend origins, comma separated. "*" allows all.
CORS_ORIGINS=*
